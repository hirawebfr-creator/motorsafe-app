{
  "name": "motorsafe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "node scripts/next-build.js",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "echo 'Skipping lint in this environment' && exit 0",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "reset-db": "npm run prisma:migrate:reset && npm run prisma:generate",
    "smoke": "node scripts/smoke.js",
    "backfill:garage": "node scripts/backfill-garage.js",
    "create:admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.542.0",
    "next": "16.1.0",
    "pdfkit": "^0.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/date-fns": "^2.5.3",
    "@types/node": "25.0.3",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "19.2.7",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "prisma": "^6.19.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
