{
  "name": "motorsafe",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/next-dev.js",
    "dev:fg": "node scripts/next-dev-fg.js",
    "dev:daemon": "node scripts/next-dev-daemon.js",
    "dev:stop": "node scripts/next-dev-stop.js",
    "dev:stop:fg": "node scripts/next-dev-stop-fg.js",
    "dev:webpack": "node scripts/next-dev-fg.js",
    "dev:turbo": "next dev",
    "build": "node scripts/next-build.js",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "lint": "node scripts/eslint-run.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:api-e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:login": "playwright test tests/e2e/01-login.spec.ts",
    "test:e2e:inscription": "playwright test tests/e2e/02-inscription-pro.spec.ts",
    "test:e2e:workflow": "playwright test tests/e2e/03-workflow.spec.ts",
    "test:e2e:critical": "playwright test tests/e2e/01-login.spec.ts tests/e2e/02-inscription-pro.spec.ts tests/e2e/03-workflow.spec.ts",
    "test:seed": "tsx tests/fixtures/seed-test-data.ts",
    "test:seed:clean": "tsx tests/fixtures/seed-test-data.ts clean",
    "test:e2e:with-seed": "npm run test:seed && npm run test:e2e:critical",
    "test:quote-invoice": "tsx scripts/quote-invoice-tests.ts",
    "test:crud": "tsx scripts/crud-tests.ts",
    "test:api-e2e": "tsx scripts/api-e2e-tests.ts",
    "test:critical-flow": "EMAIL_PROVIDER=mock DISABLE_RATE_LIMIT=true tsx scripts/critical-flow-tests.ts",
    "test:signature-api": "tsx scripts/signature-api-tests.ts",
    "test:all": "npm run test:api-e2e && npm run test:signature-api",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "reset-db": "npm run prisma:migrate:reset && npm run prisma:generate",
    "smoke": "node scripts/smoke.js",
    "backfill:garage": "node scripts/backfill-garage.js",
    "create:admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/s3-request-presigner": "^3.962.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.34.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.24.2",
    "lucide-react": "^0.542.0",
    "next": "16.1.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "resend": "^6.7.0",
    "sonner": "^2.0.7",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/date-fns": "^2.5.3",
    "@types/node": "25.0.3",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
