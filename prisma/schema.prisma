generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GARAGE
  OWNER
  STAFF
  PARTNER   // PARTNER-PROGRAM-01: External partner/affiliate
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum InterventionStatus {
  DRAFT
  OPEN
  DONE
  CANCELED
}

enum DocumentType {
  INTERVENTION_REPORT
  UPLOAD
  QUOTE_PDF
  INVOICE_PDF
  SIGNED_DOCUMENT
  AUDIT_TRAIL
}

// ============================================
// SUPPORT-OMNI-01: Support Ticket System
// ============================================

enum SupportChannel {
  FORM
  EMAIL
  WHATSAPP
}

enum SupportCategory {
  BUG
  BILLING
  FEATURE
  LEGAL
  OTHER
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportAuthorType {
  REQUESTER
  GARAGE_USER
  ADMIN
}

// AI-AUTO-TRIAGE-02: Source of automatic triage
enum TriageSource {
  RULES  // Rule-based (keywords, category)
  AI     // AI-powered classification
}

enum GarageStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum LegalSeverity {
  INFO
  WARNING
  CRITICAL
}

model Garage {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String?   @unique
  email      String    @unique
  phone      String?
  address    String?
  siret      String?
  status     GarageStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  // Branding / Profile
  displayName   String?   // Nom commercial affiché
  legalName     String?   // Raison sociale complète
  addressLine1  String?   // Adresse ligne 1
  addressLine2  String?   // Adresse ligne 2 (optionnel)
  postalCode    String?   // Code postal
  city          String?   // Ville
  country       String    @default("France")
  logoKey       String?   // Clé S3/local du logo
  brandColor    String?   // Couleur accent (hex, ex: #4ADE80) - PRO only

  // Organisation settings (quotes/invoices)
  vatNumber       String?                     // Numéro TVA intracommunautaire (ex: FR12345678901)
  defaultVatRate  Float  @default(0.20)
  defaultVatMode  String @default("EXCL")
  vatRatesAllowed Json   @default("[0,0.055,0.10,0.20]")
  quotePrefix       String @default("DEV")
  invoicePrefix     String @default("FAC")
  interventionPrefix String @default("INT")
  numberPadding   Int    @default(4)

  // LEGAL-RETENTION-01: Data retention policy settings
  retentionSignedDocsYears   Int @default(10)   // Signed documents (5-10 years legal)
  retentionAccountingYears   Int @default(10)   // Invoices/quotes (10 years fiscal)
  retentionOperationalDays   Int @default(365)  // Operational data (1 year default)

  // Partner badge (SafeMotor Partner)
  partnerBadgeEnabled       Boolean @default(false)  // Opt-in by garage
  partnerBadgeAdminOverride String  @default("NONE") // NONE | FORCE_ON | FORCE_OFF

  // Public profile (displayed on /garages-partenaires)
  publicProfileEnabled Boolean @default(false)  // Opt-in for public listing
  publicPhone          String?                  // Public phone (optional, distinct from internal)
  publicWebsite        String?                  // Public website URL

  // Referral program
  referralCode          String?  @unique        // Unique code for this garage (e.g., SAFE-XXXX)
  referredByGarageId    Int?                    // Garage that referred this one
  referralStatus        String   @default("NONE") // NONE | PENDING | APPROVED | ACTIVE_SUB
  referralRewardMonths  Int      @default(0)    // Free months earned from referrals
  pendingReferralCouponId       String?         // Stripe coupon ID awaiting confirmation
  pendingReferralMonthsApplied  Int?            // Months being applied (pending confirmation)

  referredByGarage      Garage?  @relation("GarageReferrals", fields: [referredByGarageId], references: [id])
  referredGarages       Garage[] @relation("GarageReferrals")

  plan                Plan               @default(FREE)
  stripeCustomerId    String?            @unique
  stripeSubscriptionId String?           @unique
  subscriptionStatus  SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd    DateTime?
  trialEnd            DateTime?

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  interventions Intervention[]

  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]
  stripeEvents  StripeEvent[]

  numberSequences NumberSequence[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  signatureRequests SignatureRequest[]
  vehicleLookupUsage VehicleLookupUsage[]
  evidenceChain   EvidenceChain[]
  automationJobs  AutomationJob[]
  notificationSettings GarageNotificationSettings?
  appointments    Appointment[]
  repairOrders    RepairOrder[]
  loanVehicles    LoanVehicle[]
  loanContracts   LoanContract[]
  returnReports   ReturnReport[]
  incidentCases   IncidentCase[]   // INSURANCE-INCIDENT-01
  documentVersions DocumentVersion[] // EVIDENCE-LOCKDOWN-01
  evidenceAddenda  EvidenceAddendum[] // EVIDENCE-LOCKDOWN-01
  
  // MULTI-USER-ROLES-01: Team members
  members         GarageMember[]
  
  // IMPORT-ONBOARDING-01: Onboarding wizard status and import batches
  onboardingStatus   String   @default("NEW") // NEW | IN_PROGRESS | DONE
  importBatches      ImportBatch[]
  
  // LEADS-CRM-01: Leads converted to trial
  leadsConverted     Lead[]   @relation("LeadToGarage")
  
  // DEMO-SCENARIO-01: Demo mode for sales presentations
  isDemo             Boolean  @default(false)   // True = demo garage (protected)
  demoSeedVersion    Int      @default(1)       // Seed version for reset
  demoState          DemoState?
  
  // PARTNER-PROGRAM-01: Partner attributions and commissions
  partnerAttribution PartnerAttribution?
  partnerCommissions PartnerCommissionLine[] @relation("GarageCommissions")
  
  // SUPPORT-OMNI-01: Support tickets
  supportTickets     SupportTicket[]
  
  // LEGAL-PACK-01: Custom clause sets
  clauseSets         ClauseSet[]
  
  // EVIDENCE-CAPTURE-01: Evidence capture sessions and items
  evidenceCaptureSessions EvidenceCaptureSession[]
  evidenceItems           EvidenceItem[]
}

model User {
  id           String   @id @default(cuid())
  garageId     Int?
  email        String   @unique
  passwordHash String
  role         UserRole @default(GARAGE)
  createdAt    DateTime @default(now())

  garage   Garage?   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  sessions Session[]

  notifications Notification[]
  auditLogs      AuditLog[]
  createdAppointments Appointment[]
  
  // MULTI-USER-ROLES-01: Team memberships
  memberships   GarageMember[]
  
  // IMPORT-ONBOARDING-01: Import batches created by this user
  importBatches ImportBatch[]
  
  // INSURANCE-INCIDENT-01: Incident cases created by this user
  createdIncidentCases IncidentCase[] @relation("CreatedIncidentCases")
  
  // LEADS-CRM-01: Leads owned by this admin user
  ownedLeads       Lead[]         @relation("LeadOwner")
  leadActivities   LeadActivity[] @relation("LeadActivityCreator")
  
  // DEMO-SCENARIO-01: Demo mode activation
  demoModeEnabledAt DateTime?   // When demo mode was enabled
  
  // PARTNER-PROGRAM-01: If this user is a partner
  partner          Partner?
  
  // SUPPORT-OMNI-01: Support tickets and messages
  createdSupportTickets  SupportTicket[]  @relation("SupportTicketCreator")
  supportMessages        SupportMessage[] @relation("SupportMessageAuthor")
  
  // KNOWLEDGE-BASE-01: KB articles created/updated by this user
  createdKbArticles      KbArticle[]      @relation("KbArticleCreator")
  updatedKbArticles      KbArticle[]      @relation("KbArticleUpdater")
  
  // AI-SUGGEST-01: AI suggestions requested by this admin
  aiSuggestions          SupportAiSuggestion[] @relation("SupportAiSuggestionRequestedBy")
  
  // IN-APP-STATUS-AND-CHANGES-01: Changelog & Maintenance created by admin
  createdChangelogs      ChangelogEntry[]      @relation("ChangelogCreator")
  createdMaintenances    MaintenanceWindow[]   @relation("MaintenanceCreator")
  
  // EVIDENCE-LOCKDOWN-01: Document versions and addenda created by user
  createdDocumentVersions DocumentVersion[]    @relation("DocumentVersionCreator")
  createdEvidenceAddenda  EvidenceAddendum[]   @relation("AddendumCreator")
  
  // EVIDENCE-CAPTURE-01: Evidence capture sessions and items created by user
  createdEvidenceSessions EvidenceCaptureSession[] @relation("EvidenceSessionCreator")
  createdEvidenceItems    EvidenceItem[]           @relation("EvidenceItemCreator")

  @@index([garageId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// MULTI-USER-ROLES-01: Team membership
// ============================================

enum GarageRole {
  OWNER       // Propriétaire - accès complet
  MANAGER     // Chef d'atelier - gestion équipe, billing
  STAFF       // Mécano - interventions, véhicules
  RECEPTION   // Secrétaire - clients, planning
  READONLY    // Consultation seule
}

enum MemberStatus {
  INVITED     // Invitation envoyée, pas encore acceptée
  ACTIVE      // Membre actif
  DISABLED    // Désactivé par admin
}

model GarageMember {
  id              String       @id @default(cuid())
  garageId        Int
  userId          String?      // Null si invitation en attente
  role            GarageRole   @default(STAFF)
  status          MemberStatus @default(INVITED)
  
  // Invitation fields
  invitedEmail    String?      // Email utilisé pour l'invitation
  inviteTokenHash String?      // SHA256 du token d'invitation
  inviteExpiresAt DateTime?    // Expiration de l'invitation (7 jours)
  
  // Timestamps
  invitedAt       DateTime     @default(now())
  acceptedAt      DateTime?    // Quand l'invitation a été acceptée
  disabledAt      DateTime?    // Quand le membre a été désactivé
  disabledReason  String?      // Motif de désactivation
  
  // Relations
  garage          Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Unique constraints
  @@unique([garageId, userId])           // Un user ne peut être membre qu'une fois par garage
  @@unique([garageId, invitedEmail])     // Un email ne peut être invité qu'une fois par garage
  @@index([garageId])
  @@index([userId])
  @@index([inviteTokenHash])
}

model Client {
  id        Int      @id @default(autoincrement())
  garageId  Int?
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  vatProfile  String @default("PARTICULIER")
  vatRateOverride Float?
  vatNumber   String?
  countryCode String @default("FR")

  email   String?
  phone   String?
  address String?
  notes   String?

  // LEGAL-RETENTION-01: GDPR anonymization tracking
  anonymizedAt   DateTime?  // When client was anonymized (GDPR request)
  anonymizedBy   String?    // userId who performed anonymization

  garage   Garage?  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  quotes   Quote[]
  invoices Invoice[]
  appointments Appointment[]
  loanContracts LoanContract[]

  @@index([garageId])
  @@index([garageId, deletedAt])
  @@index([garageId, lastName, firstName])
}

model Vehicle {
  id        String   @id @default(cuid())
  garageId  Int?
  clientId  Int
  brand     String
  model     String
  plate     String
  vin       String?
  fuel      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  year   Int?
  engine String?

  garage        Garage?        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  quotes   Quote[]
  invoices Invoice[]

  documents Document[]
  appointments Appointment[]

  @@index([garageId])
  @@index([clientId])
  @@index([garageId, deletedAt])
  @@unique([garageId, plate])
  @@unique([garageId, vin])
}

model Intervention {
  id        String   @id @default(cuid())
  garageId  Int?
  vehicleId String
  type      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  status InterventionStatus @default(OPEN)

  title   String?
  amountCents Int?
  // traceability
  createdBy String?
  clientIp  String?
  userAgent String?

  // proof of integrity
  hash    String? @unique
  payload String? // JSON string (snapshot)

  // structured fields for professional interventions / insurance
  performedAt     DateTime?
  odometerKm      Int?
  ecuType         String?
  softwareVersion String?
  checksum        String?

  // === FLOW-INT-01: Parcours logique intervention ===
  // Multi-tags for intervention type
  tags            String[]   @default([])
  
  // Intake (reception)
  intakeChecklist Json?      // { lights: bool, noises: bool, leaks: bool, smoke: bool, ... }
  intakeNotes     String?
  
  // Client agreement
  agreementAt     DateTime?
  agreementMethod String?    // "in_app", "phone", "email", etc.
  
  // Work performed
  workNotes       String?
  partsNotes      String?
  
  // Outtake (restitution)
  outtakeChecklist Json?     // { roadTest: bool, lights: bool, clean: bool, ... }
  closedAt         DateTime?

  // LEGAL-RETENTION-01: Dispute mode (tamper-evident lock)
  disputeStatus     String?    // null = normal, "OPEN" = locked, "CLOSED" = resolved
  disputeOpenedAt   DateTime?  // When dispute was opened
  disputeOpenedBy   String?    // userId who opened dispute
  disputeClosedAt   DateTime?  // When dispute was closed
  disputeClosedBy   String?    // userId who closed dispute
  disputeReason     String?    // Why dispute was opened
  disputeResolution String?    // How dispute was resolved
  disputeSnapshotHash String?  // SHA256 of intervention state at dispute open

  // revisions store immutable snapshots when interventions are created/edited
  revisions InterventionRevision[]

  documents Document[]
  downloadTokens DownloadToken[]
  appointments Appointment[]
  repairOrder  RepairOrder?
  returnReport ReturnReport?
  incidentCase IncidentCase?   // INSURANCE-INCIDENT-01
  documentVersions DocumentVersion[] // EVIDENCE-LOCKDOWN-01
  evidenceAddenda  EvidenceAddendum[] // EVIDENCE-LOCKDOWN-01
  
  // EVIDENCE-CAPTURE-01: Evidence capture sessions and items
  evidenceCaptureSessions EvidenceCaptureSession[]
  evidenceItems           EvidenceItem[]

  garage  Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([vehicleId])
  @@index([garageId, deletedAt])
  @@index([garageId, createdAt(sort: Desc)])
  @@index([garageId, status])
}

model Document {
  id             String   @id @default(cuid())
  garageId       Int?
  vehicleId      String?
  interventionId String?

  type     DocumentType
  category String?      @default("DIVERS")  // ENTREE, SORTIE, DIAGNOSTIC, PIECES, DIVERS
  fileUrl  String
  fileName String
  mime     String
  size     Int

  createdAt DateTime @default(now())
  deletedAt DateTime?

  garage       Garage?       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([vehicleId])
  @@index([interventionId])
  @@index([garageId, deletedAt])
  @@index([garageId, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(cuid())
  garageId  Int?
  userId    String?
  type      String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  garageId   Int?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([userId])
  @@index([entityType, entityId])
}

// ============================================
// IMPORT-ONBOARDING-01: Import Batch Tracking
// ============================================

enum ImportKind {
  CLIENTS
  VEHICULES
}

enum ImportStatus {
  DRAFT           // Just created, mapping in progress
  DRY_RUN_DONE    // Dry-run completed, ready for commit
  IMPORTED        // Successfully imported
  ROLLED_BACK     // Rolled back by user
  FAILED          // Import failed
}

model ImportBatch {
  id              String       @id @default(cuid())
  garageId        Int
  kind            ImportKind
  status          ImportStatus @default(DRAFT)
  createdByUserId String?
  
  // Column mapping: { csvColumn: fieldName }
  mappingJson     Json?
  
  // Stats: { totalRows, created, updated, skipped, errorsCount }
  statsJson       Json?
  
  // Error samples (max 50): [{ row, field, message }]
  errorSampleJson Json?
  
  // Track created entity IDs for rollback
  createdIdsJson  Json?        // Array of created client/vehicle IDs
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  
  garage          Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([garageId, createdAt])
  @@index([garageId, status])
}

// ============================================================
// INSURANCE-INCIDENT-01: Incident Case for insurance/legal documentation
// ============================================================

enum IncidentCaseStatus {
  DRAFT
  OPEN
  CLOSED
}

enum IncidentType {
  ENGINE
  GEARBOX
  ELECTRICAL
  BRAKES
  SUSPENSION
  BODY
  FUEL_SYSTEM
  OTHER
}

model IncidentCase {
  id                String             @id @default(cuid())
  garageId          Int
  interventionId    String             @unique  // One incident case per intervention
  
  status            IncidentCaseStatus @default(DRAFT)
  incidentType      IncidentType?
  
  // Incident timeline
  openedAt          DateTime?
  closedAt          DateTime?
  
  // Structured description
  description       String?            // What happened
  circumstances     String?            // How/when it happened
  damagesObserved   String?            // Visible damages
  
  // Statements
  customerStatement String?            // Customer's account of incident
  garageStatement   String?            // Garage's professional assessment
  
  // Attachments (photo/document keys from uploads)
  attachmentKeys    String[]           @default([])
  
  // Signature requests for statements
  customerSignatureId String?          // SignatureRequest ID for customer statement
  garageSignatureId   String?          // SignatureRequest ID for garage statement
  
  // Generated documents
  summaryPdfKey     String?            // Storage key for summary PDF
  summaryPdfHash    String?            // SHA256 of summary PDF
  exportZipKey      String?            // Storage key for insurance-ready ZIP
  exportZipHash     String?            // SHA256 of export ZIP
  
  // Evidence snapshot
  evidenceSummaryJson Json?            // Snapshot of evidence chain at export
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  createdByUserId   String?
  
  garage            Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention      Intervention       @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  createdByUser     User?              @relation("CreatedIncidentCases", fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([garageId])
  @@index([garageId, interventionId])
  @@index([garageId, status])
}

model StripeEvent {
  id            String   @id
  garageId      Int?
  type          String
  apiVersion    String?
  created       Int
  livemode      Boolean
  processedAt   DateTime?
  lastError     String?
  receivedAt    DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([type])
  @@index([processedAt])
}

model NumberSequence {
  id             String @id @default(cuid())
  organisationId Int
  type           String
  year           Int
  nextNumber     Int    @default(1)

  organisation Garage @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, type, year])
  @@index([organisationId, type, year])
}

model Quote {
  id             String   @id @default(cuid())
  organisationId Int
  clientId       Int
  vehicleId      String?

  status      String  @default("DRAFT")
  quoteNumber String?
  quoteYear   Int?
  quoteSeq    Int?

  currency     String @default("EUR")
  vatMode      String
  subtotalExcl Float  @default(0)
  totalVat     Float  @default(0)
  totalIncl    Float  @default(0)

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  invoicedAt DateTime?
  invoiceId  String?

  // Signature fields
  signToken      String?   @unique  // Token for client to access and sign
  signTokenExp   DateTime?          // Expiration of the sign token
  signedAt       DateTime?          // When client signed
  signatureData  String?            // Base64 signature image or text
  signedByName   String?            // Name entered by signer
  signedByIp     String?            // IP address of signer

  invoice Invoice? @relation("QuoteToInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  organisation Garage   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines        QuoteLine[]
  downloadTokens QuoteDownloadToken[]

  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, clientId])
  @@index([organisationId, vehicleId])
  @@index([organisationId, status])
  @@index([organisationId, quoteNumber])
}

model QuoteLine {
  id            String   @id @default(cuid())
  quoteId       String
  description   String
  qty           Float    @default(1)
  unitPriceExcl Float
  vatRate       Float    @default(0.20)
  lineTotalExcl Float    @default(0)
  lineVatAmount Float    @default(0)
  lineTotalIncl Float    @default(0)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([quoteId, deletedAt])
}

model Invoice {
  id             String   @id @default(cuid())
  organisationId Int
  clientId       Int
  vehicleId      String?
  quoteId        String? @unique

  status        String  @default("DRAFT")  // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELED
  invoiceNumber String?
  invoiceYear   Int?
  invoiceSeq    Int?

  currency     String @default("EUR")
  vatMode      String
  subtotalExcl Float  @default(0)
  totalVat     Float  @default(0)
  totalIncl    Float  @default(0)
  amountPaid   Float  @default(0)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  // PAYMENTS-01: Payment link for online payments
  paymentLinkUrl       String?   // Current active Stripe Checkout URL
  paymentLinkExpiresAt DateTime? // Link expiration (24h by default)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  organisation Garage   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  quote        Quote?   @relation("QuoteToInvoice", fields: [quoteId], references: [id], onDelete: SetNull)

  lines    InvoiceLine[]
  payments Payment[]
  downloadTokens InvoiceDownloadToken[]

  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, clientId])
  @@index([organisationId, vehicleId])
  @@index([organisationId, status])
  @@index([organisationId, invoiceNumber])
}

model InvoiceLine {
