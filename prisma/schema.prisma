// ============================================
// SIGN-CORE-01: Signature System
// ============================================

enum SignatureDocumentType {
  INTERVENTION_ORDER
  INTERVENTION_DELIVERY
  INTERVENTION_DOSSIER
  QUOTE
  REPAIR_ORDER          // WORKSHOP-OPS-01: Ordre de Réparation
  RETURN_REPORT         // WORKSHOP-OPS-01: PV de restitution
  LOAN_CONTRACT_OUT     // WORKSHOP-OPS-01: Contrat prêt (départ)
  LOAN_CONTRACT_IN      // WORKSHOP-OPS-01: Contrat prêt (retour)
}

enum SignatureStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  VOID
  SUPERSEDED  // HARDEN-01: When replaced by a new revision
}

model SignatureRequest {
  id               String                @id @default(cuid())
  token            String                @unique
  expiresAt        DateTime
  documentType     SignatureDocumentType
  documentId       String
  garageId         Int
  clientId         Int?
  status           SignatureStatus       @default(DRAFT)
  pdfHash          String?               // Hash du PDF avant signature
  pdfRoute         String?
  signerNameDeclared String?
  signerEmail      String?
  signedAt         DateTime?
  lastViewedAt     DateTime?
  sentAt           DateTime?             // Date d'envoi
  voidedAt         DateTime?             // Date d'annulation
  createdAt        DateTime              @default(now())
  createdByUserId  String?
  
  // HARDEN-01: Revision tracking
  revision         Int                   @default(1)
  supersededById   String?               // ID of the new revision that replaced this one
  
  // Signed PDF storage
  signedPdfHash    String?               // SHA256 du PDF signé final
  signedPdfKey     String?               // Clé de stockage (local ou S3)
  signedPdfUrl     String?               // URL publique ou route
  
  // Legal snapshot at signature time
  legalSnapshotJson String?              // JSON des clauses exactes signées
  legalSnapshotHash String?              // SHA256 du snapshot légal

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  events SignatureEvent[]

  @@index([token])
  @@index([garageId])
  @@index([documentType, documentId])
  @@index([status])
  @@index([garageId, status])
}

model SignatureEvent {
  id                 String   @id @default(cuid())
  signatureRequestId String
  type               String   // CREATED, SENT, VIEWED, SIGNED, DECLINED
  at                 DateTime @default(now())
  ip                 String?
  userAgent          String?
  metaJson           Json?

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId])
}

// ============================================
// DOWNLOAD TOKENS: Secure download links for signed documents
// ============================================

model DownloadToken {
  id             String   @id @default(cuid())
  interventionId String
  purpose        String   // SIGNED_PDF, DOSSIER_ZIP
  tokenHash      String   @unique // SHA256 of the actual token
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  usedAt         DateTime? // Optional: mark first download

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@unique([interventionId, purpose])
  @@index([tokenHash])
  @@index([interventionId])
}

// ============================================
// VEHICLE-LOOKUP: Plate lookup cache, usage quotas, logs
// ============================================

/// Monthly quota tracking per garage (for billing/rate limiting)
model VehicleLookupUsage {
  id        String @id @default(cuid())
  garageId  Int
  monthKey  String // "2026-01" format
  count     Int    @default(0)
  updatedAt DateTime @updatedAt

  garage    Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, monthKey])
  @@index([garageId])
}

model VehicleLookupCache {
  id              String   @id @default(cuid())
  garageId        Int
  plateNormalized String
  provider        String   @default("apiplaqueimmatriculation")
  dataJson        String   // JSON string of VehiclePrefill
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([garageId, plateNormalized, provider])
  @@index([garageId])
  @@index([expiresAt])
}

model VehicleLookupLog {
  id              String   @id @default(cuid())
  garageId        Int
  plateNormalized String
  provider        String
  success         Boolean
  source          String?  // "cache" | "api"
  errorCode       String?
  latencyMs       Int?     // API call duration in milliseconds
  createdAt       DateTime @default(now())

  @@index([garageId])
  @@index([createdAt])
}

// ============================================================
// Referral Events (tracking)
// ============================================================
model ReferralEvent {
  id               String   @id @default(cuid())
  referrerGarageId Int
  refereeGarageId  Int
  eventType        String   // REF_APPLIED | REF_APPROVED | REWARD_GRANTED
  createdAt        DateTime @default(now())
  metaJson         String?  // Optional JSON metadata

  @@index([referrerGarageId])
  @@index([refereeGarageId])
  @@index([createdAt])
}

// ============================================================
// AI Usage Tracking (quota enforcement)
// ============================================================
model AiUsageLog {
  id             String   @id @default(cuid())
  garageId       Int
  interventionId String?  // Optional: may be used outside interventions in future
  mode           String   // CHECKLIST | SUMMARY | RISKS
  provider       String   // openai | anthropic | mock
  tokensUsed     Int      @default(0)
  success        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([garageId, createdAt])
  @@index([createdAt])
}

// ============================================================
// Rate Limiting Buckets (anti-abuse)
// ============================================================
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   // e.g., "ip:1.2.3.4:sign_get" or "garage:123:send_email"
  windowStart DateTime // Start of the rate limit window (rounded to window size)
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
  @@index([windowStart])
}

// System health events for admin monitoring (no PII)
model SystemEvent {
  id        String   @id @default(cuid())
  type      String   // "health_check" | "alert" | "recovery" | "startup"
  service   String   // "db" | "stripe" | "email" | "ai" | "storage" | "system"
  status    String   // "ok" | "degraded" | "down"
  message   String?  // Generic message, no PII
  metadata  Json?    // Metrics only (latency, counts)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([service])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// LEGAL-RETENTION-01: EvidenceChain - Tamper-evident hash chain
// ============================================================
// Each entry contains hash of (previous_hash + payload) creating a chain.
// Used for: dispute snapshots, critical legal events, GDPR actions.
// Any tampering breaks the chain - detectible by verification.

model EvidenceChain {
  id           String   @id @default(cuid())
  garageId     Int
  entityType   String   // "intervention" | "client" | "signature" | "invoice"
  entityId     String   // ID of the entity (interventionId, clientId, etc.)
  eventType    String   // "dispute_open" | "dispute_close" | "anonymize" | "export" | "snapshot"
  
  payload      String   // JSON snapshot of entity state at this moment
  payloadHash  String   // SHA256(payload)
  previousHash String?  // Hash of previous entry in chain (null for first entry per entity)
  chainHash    String   // SHA256(previousHash + payloadHash) - the immutable chain link
  
  userId       String?  // Who performed the action
  ip           String?  // IP address (for legal traceability)
  userAgent    String?  // Browser/client info
  reason       String?  // Why this event occurred (dispute reason, etc.)
  
  createdAt    DateTime @default(now())

  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@index([chainHash])
}

// ============================================================
// AUTOMATIONS-01: Job scheduler for reminders and alerts
// ============================================================

enum AutomationJobKind {
  SIGN_REMINDER
  QUOTE_REMINDER
  INVOICE_REMINDER
  QUOTA_ALERT
  ADMIN_DIGEST
  APPOINTMENT_REMINDER
}

enum AutomationJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model AutomationJob {
  id         String              @id @default(cuid())
  kind       AutomationJobKind
  garageId   Int
  targetType String              // "signature_request" | "quote" | "invoice" | "garage"
  targetId   String              // ID of the target entity
  
  runAt      DateTime            // When to execute
  status     AutomationJobStatus @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?             // Redacted error message
  
  // Deduplication key for quota alerts (e.g., "garage:1:quota:vehicleLookup:80:2026-01")
  dedupKey   String?             @unique
  
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  garage     Garage              @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([garageId])
  @@index([kind])
  @@index([targetType, targetId])
}

// Garage notification preferences (opt-in toggles)
model GarageNotificationSettings {
  id                    String   @id @default(cuid())
  garageId              Int      @unique
  
  // Reminder toggles
  signatureReminders    Boolean  @default(true)
  quoteReminders        Boolean  @default(false)
  invoiceReminders      Boolean  @default(false)
  quotaAlerts           Boolean  @default(true)
  appointmentsReminders Boolean  @default(true)
  
  // Daily email limit to prevent spam (per garage)
  dailyEmailLimit       Int      @default(50)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  garage                Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

// ============================================================
// APPOINTMENTS-01: Appointment scheduling
// ============================================================

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
  NO_SHOW
}

enum ReminderPolicy {
  NONE
  STANDARD  // J-1 + H-2
}

model Appointment {
  id              String            @id @default(cuid())
  garageId        Int
  clientId        Int
  vehicleId       String?
  interventionId  String?
  
  title           String            // "Diag", "E85", "Reprog", etc.
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  
  // Reminder configuration
  reminderPolicy      ReminderPolicy @default(NONE)
  reminderSentJ1At    DateTime?      // J-1 reminder sent timestamp
  reminderSentH2At    DateTime?      // H-2 reminder sent timestamp
  
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  garage          Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  intervention    Intervention?     @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([garageId, startAt])
  @@index([garageId, clientId])
  @@index([interventionId])
}

// ============================================
// WORKSHOP-OPS-01: Repair Order (Ordre de Réparation)
// ============================================

enum RepairOrderStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

model RepairOrder {
  id             String            @id @default(cuid())
  garageId       Int
  interventionId String            @unique
  status         RepairOrderStatus @default(DRAFT)
  
  // Snapshot of intervention data at issue time
  snapshotJson   String?           // JSON: vehicle, client, items, prices, clauses
  
  // PDF storage
  pdfKey         String?           // Storage key (local or S3)
  pdfHashSha256  String?           // SHA256 of the PDF
  
  // Signature
  signatureRequestId String?       // FK to SignatureRequest
  
  // Timestamps
  issuedAt       DateTime?         // When OR was frozen and sent
  signedAt       DateTime?         // When client signed
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  garage         Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention   Intervention      @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([garageId, interventionId])
}

// ============================================
// WORKSHOP-OPS-01: Loan Vehicle (Véhicule de prêt)
// ============================================

model LoanVehicle {
  id           String   @id @default(cuid())
  garageId     Int
  plate        String   // License plate (stored for identification)
  make         String?  // Brand
  model        String?
  year         Int?
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  contracts    LoanContract[]

  @@index([garageId])
  @@index([garageId, active])
}

// ============================================
// WORKSHOP-OPS-01: Loan Contract (Contrat de prêt)
// ============================================

enum LoanContractStatus {
  OUT        // Vehicle is out with client
  RETURNED   // Vehicle returned normally
  DISPUTE    // Issue with return
}

enum FuelLevel {
  EMPTY      // 0%
  QUARTER    // 25%
  HALF       // 50%
  THREE_QUARTERS // 75%
  FULL       // 100%
}

model LoanContract {
  id              String             @id @default(cuid())
  garageId        Int
  loanVehicleId   String
  clientId        Int
  interventionId  String?            // Optional link to intervention
  
  // Departure (OUT)
  startAt         DateTime
  endAtPlanned    DateTime?          // Planned return date
  kmOut           Int                // Odometer at departure
  fuelOut         FuelLevel          @default(HALF)
  conditionOut    String?            // Text description of vehicle state
  photosOutKeys   String[]           @default([]) // Storage keys for photos
  
  // Return (IN)
  returnAt        DateTime?          // Actual return date
  kmIn            Int?               // Odometer at return
  fuelIn          FuelLevel?
  conditionIn     String?            // Text description at return
  photosInKeys    String[]           @default([]) // Storage keys for photos
  
  status          LoanContractStatus @default(OUT)
  
  // PDF storage
  pdfKey          String?            // Contract PDF storage key
  pdfHashSha256   String?            // SHA256 of the PDF
  
  // Signatures (two: one at departure, one at return)
  signatureRequestOutId String?      // Signature for departure
  signatureRequestInId  String?      // Signature for return
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  garage          Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  loanVehicle     LoanVehicle        @relation(fields: [loanVehicleId], references: [id], onDelete: Cascade)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([garageId, clientId])
  @@index([garageId, loanVehicleId])
  @@index([garageId, startAt])
}

// ============================================
// WORKSHOP-OPS-01: Return Report (PV de restitution)
// ============================================

enum ReturnReportStatus {
  DRAFT
  SENT
  SIGNED
}

model ReturnReport {
  id             String             @id @default(cuid())
  garageId       Int
  interventionId String             @unique
  
  // Checklist data
  checklistJson  String?            // JSON: { roadTest: bool, lights: bool, clean: bool, damages: [], ... }
  notes          String?
  
  // Photos
  photosKeys     String[]           @default([]) // Storage keys for photos
  
  status         ReturnReportStatus @default(DRAFT)
  
  // PDF storage
  pdfKey         String?            // Storage key (local or S3)
  pdfHashSha256  String?            // SHA256 of the PDF
  
  // Signature
  signatureRequestId String?        // FK to SignatureRequest
  
  // Timestamps
  issuedAt       DateTime?          // When PV was frozen and sent
  signedAt       DateTime?          // When client signed
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  garage         Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention   Intervention       @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([garageId, interventionId])
}

// ============================================
// LEADS-CRM-01: Internal Sales CRM
// ============================================

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  DEMO_DONE
  TRIAL_STARTED
  WON
  LOST
}

enum LeadChannel {
  INSTAGRAM
  FACEBOOK
  SMS
  EMAIL
  PHONE
  LINKEDIN
  REFERRAL
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  SMS
  EMAIL
  DM
  DEMO
  STATUS_CHANGE
}

/// Prospect garage in sales pipeline (admin-only)
model Lead {
  id              Int        @id @default(autoincrement())
  
  // Basic info
  garageName      String
  city            String?
  postalCode      String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  
  // Pipeline
  status          LeadStatus @default(NEW)
  channel         LeadChannel @default(OTHER)
  source          String?    // Détail source (nom campagne, etc.)
  
  // Follow-up
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  notes           String?    // Notes libres
  
  // Conversion
  trialGarageId   Int?       // Lien vers Garage si converti en trial
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  
  // Ownership
  ownerUserId     String?    // Admin responsable
  
  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // RGPD
  anonymizedAt    DateTime?  // Si nettoyé
  
  // Relations
  activities      LeadActivity[]
  trialGarage     Garage?    @relation("LeadToGarage", fields: [trialGarageId], references: [id])
  ownerUser       User?      @relation("LeadOwner", fields: [ownerUserId], references: [id])

  @@index([ownerUserId, status])
  @@index([ownerUserId, nextFollowUpAt])
  @@index([status])
  @@index([createdAt])
}

/// Activity log for a lead (notes, calls, status changes)
model LeadActivity {
  id              Int              @id @default(autoincrement())
  leadId          Int
  
  type            LeadActivityType
  summary         String           // Description courte
  details         String?          // Détails longs (optionnel)
  
  // For status changes
  oldStatus       LeadStatus?
  newStatus       LeadStatus?
  
  // Who did this
  createdByUserId String?
  
  createdAt       DateTime         @default(now())
  
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("LeadActivityCreator", fields: [createdByUserId], references: [id])

  @@index([leadId, createdAt])
}

// ============================================
// DEMO-SCENARIO-01: Demo State Tracking
// ============================================

/// Tracks demo progress for a garage
model DemoState {
  id            Int      @id @default(autoincrement())
  garageId      Int      @unique
  
  currentStep   Int      @default(0)  // Current step in demo flow (0-7)
  completedAt   DateTime?             // When demo was completed
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  garage        Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

// ============================================
// PARTNER-PROGRAM-01: Partner Affiliate System
// ============================================

enum PartnerType {
  GARAGE      // Garage owner becoming affiliate
  INFLUENCER  // Content creator / YouTuber
  AGENCY      // Marketing agency
  OTHER
}

enum CommissionMode {
  FIRST_MONTH_PERCENT    // 20% of first month payment
  THREE_MONTHS_PERCENT   // X% of first 3 months (more complex)
}

enum PayoutStatus {
  DUE
  PAID
  CANCELLED
}

/// External partner (distinct from garage-to-garage referral)
model Partner {
  id               Int             @id @default(autoincrement())
  name             String          // Partner name or company
  email            String          @unique
  type             PartnerType     @default(OTHER)
  
  // Affiliate tracking
  refCode          String          @unique  // Unique ref code (e.g., PARTNER-XXXX)
  stripeCouponId   String?                  // Optional Stripe coupon for this partner
  
  // Commission settings
  commissionMode   CommissionMode  @default(FIRST_MONTH_PERCENT)
  commissionPercent Int            @default(20)  // Percentage (20 = 20%)
  minPayoutCents   Int             @default(5000) // Min payout threshold (5000 = 50€)
  
  // Status
  isActive         Boolean         @default(true)
  
  // If partner is also a garage user (optional link)
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id])
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  attributions     PartnerAttribution[]
  commissionLines  PartnerCommissionLine[]
  payouts          PartnerPayout[]

  @@index([refCode])
  @@index([isActive])
}

/// Links a garage to the partner who referred them
model PartnerAttribution {
  id             Int      @id @default(autoincrement())
  partnerId      Int
  garageId       Int      @unique  // 1 garage = 1 partner attribution only
  
  source         String   // REF_LINK | COUPON
  refCodeUsed    String?  // The ref code used (if via link)
  couponCodeUsed String?  // The Stripe coupon code used (if via coupon)
  
  attributedAt   DateTime @default(now())
  
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  garage         Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

/// Individual commission earned per Stripe invoice
model PartnerCommissionLine {
  id              Int      @id @default(autoincrement())
  partnerId       Int
  garageId        Int
  stripeInvoiceId String   @unique  // Stripe invoice ID (prevents duplicates)
  
  invoiceAmountCents  Int      // Total invoice amount TTC
  commissionCents     Int      // Commission earned
  commissionPercent   Int      // Rate at time of calculation
  
  // Anti-fraud: track if refunded within grace period
  isValid         Boolean  @default(true)
  invalidatedAt   DateTime?
  invalidReason   String?
  
  createdAt       DateTime @default(now())
  
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  garage          Garage   @relation("GarageCommissions", fields: [garageId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([garageId])
}

/// Aggregated payout to partner (manual processing MVP)
model PartnerPayout {
  id          Int          @id @default(autoincrement())
  partnerId   Int
  
  periodStart DateTime     // Payout period start
  periodEnd   DateTime     // Payout period end
  amountCents Int          // Total payout amount
  
  status      PayoutStatus @default(DUE)
  paidAt      DateTime?
  note        String?      // Admin notes
  
  createdAt   DateTime     @default(now())
  
  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
}

// ============================================
// KNOWLEDGE-BASE-01: Knowledge Base System
// ============================================

/// KB Category for organizing articles
model KbCategory {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  articles    KbArticle[]
}

/// KB Article with markdown content
model KbArticle {
  id              Int       @id @default(autoincrement())
  categoryId      Int
  title           String
  slug            String    @unique
  bodyMarkdown    String    @db.Text
  tags            Json      @default("[]")  // String array stored as JSON
  isPublished     Boolean   @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  category        KbCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy       User?      @relation("KbArticleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?      @relation("KbArticleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([categoryId, isPublished])
}

// ============================================
// SUPPORT-OMNI-01: Support Ticket System
// ============================================

/// Support ticket created by garage users or public visitors
model SupportTicket {
  id              String              @id @default(cuid())
  garageId        Int?                // Nullable for public tickets
  createdByUserId String?             // User who created the ticket
  
  requesterName   String              // Name of the requester
  requesterEmail  String?             // Email (optional)
  requesterPhone  String?             // Phone (optional)
  
  channel         SupportChannel      @default(FORM)
  subject         String
  category        SupportCategory     @default(OTHER)
  priority        SupportPriority     @default(NORMAL)
  status          SupportTicketStatus @default(OPEN)
  
  // AI-AUTO-TRIAGE-02: Auto-triage fields
  autoTriageSource TriageSource?      // "RULES" or "AI" (null = no auto-triage)
  autoTriageAt     DateTime?          // When auto-triage was applied
  tags             String[]           @default([])
  
  // SUPPORT-SLA-01: SLA tracking
  slaTargetAt            DateTime?   // When response is due
  slaBreachedAt          DateTime?   // When SLA was breached (null if on-time)
  lastRequesterMessageAt DateTime?   // Last message from requester
  lastAdminMessageAt     DateTime?   // Last message from admin
  
  lastReplyAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  garage          Garage?             @relation(fields: [garageId], references: [id], onDelete: SetNull)
  createdByUser   User?               @relation("SupportTicketCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages        SupportMessage[]
  aiSuggestions   SupportAiSuggestion[]

  @@index([garageId, status, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([slaTargetAt, slaBreachedAt])
  @@index([autoTriageSource])
  @@index([tags])
}

/// Message in a support ticket thread
model SupportMessage {
  id           String            @id @default(cuid())
  ticketId     String
  authorType   SupportAuthorType
  authorUserId String?           // User who wrote the message (if authenticated)
  message      String            // Message content (text only, no HTML)
  createdAt    DateTime          @default(now())

  ticket       SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?             @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// AI-generated suggestion for support ticket (AI-SUGGEST-01)
/// Cached for 24h, admin-only access, PII redacted before AI call
model SupportAiSuggestion {
  id          String   @id @default(cuid())
  ticketId    String
  requestedBy String

  // Input hash for cache deduplication (SHA256 of redacted content)
  inputHash   String

  // AI structured output
  suggestedCategory      String?      // Suggested ticket category
  suggestedPriority      String?      // Suggested priority level
  confidence             Float?       // AI confidence 0-1
  summaryInternal        String?      // Internal summary (admin-only)
  draftReplyFr           String?      // Draft reply in French
  clarifyingQuestions    String[]     // Questions to ask client
  kbSuggestions          String[]     // KB article slugs
  nextActionsInternal    String[]     // Next actions (admin-only)

  // Meta
  provider    String?               // openai, anthropic, mock
  model       String?               // gpt-4o, claude-3-haiku, etc.
  tokensUsed  Int?
  cached      Boolean  @default(false)
  error       String?               // Error message if failed

  // Timestamps
  createdAt   DateTime @default(now())
  expiresAt   DateTime              // Cache expiry (24h by default)

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedByUser User     @relation("SupportAiSuggestionRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([requestedBy])
  @@index([inputHash])
  @@index([createdAt])
  @@index([expiresAt])
}

// ============================================
// IN-APP-STATUS-AND-CHANGES-01: Changelog & Maintenance
// ============================================

enum ChangelogType {
  FEATURE
  FIX
  SECURITY
  LEGAL
}

enum MaintenanceSeverity {
  INFO
  WARNING
}

/// Changelog entry visible to garages
model ChangelogEntry {
  id              String        @id @default(cuid())
  title           String
  bodyMarkdown    String        @db.Text
  type            ChangelogType
  version         String?       // e.g. "1.2.0" (optional)
  isPublished     Boolean       @default(true)
  publishedAt     DateTime      @default(now())
  
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  createdBy       User          @relation("ChangelogCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([publishedAt, isPublished])
  @@index([type])
}

/// Planned maintenance window
model MaintenanceWindow {
  id              String              @id @default(cuid())
  title           String
  message         String              @db.Text
  startsAt        DateTime
  endsAt          DateTime
  severity        MaintenanceSeverity @default(INFO)
  isActive        Boolean             @default(true)
  
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  createdBy       User                @relation("MaintenanceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([startsAt, endsAt, isActive])
}

// ============================================================
// EVIDENCE-LOCKDOWN-01: Document Versioning for forensic evidence
// ============================================================

enum DocumentVersionReason {
  GENERATED     // Initial generation
  SIGNED        // After signature
  REGENERATED   // Re-generated (new version)
  EXPORT        // Forensic export copy
}

enum DocumentVersionType {
  QUOTE
  INVOICE
  REPAIR_ORDER
  RETURN_REPORT
  INCIDENT_SUMMARY
  SIGNATURE_PDF
  ATTACHMENT
  OTHER
}

/// Immutable document versions for legal/forensic purposes
model DocumentVersion {
  id              String                @id @default(cuid())
  garageId        Int
  interventionId  String?               // Optional link to intervention
  
  documentType    DocumentVersionType
  documentId      String?               // ID of source (quote/invoice/doc)
  versionNumber   Int                   // 1, 2, 3...
  
  storageKey      String                // S3/local key
  sha256          String                // Content hash for integrity
  sizeBytes       Int
  mime            String                @default("application/pdf")
  
  reason          DocumentVersionReason
  metadata        Json?                 // Extra context (title, etc.)
  
  generatedByUserId String?
  generatedAt     DateTime              @default(now())
  
  garage          Garage                @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention    Intervention?         @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  generatedBy     User?                 @relation("DocumentVersionCreator", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  
  @@unique([documentType, documentId, versionNumber])
  @@index([garageId])
  @@index([garageId, interventionId])
  @@index([documentType, documentId])
  @@index([sha256])
}

/// Append-only addendum for locked interventions
model EvidenceAddendum {
  id              String   @id @default(cuid())
  garageId        Int
  interventionId  String
  
  text            String   @db.Text
  sha256          String   // Hash of text content
  prevHash        String?  // Hash of previous addendum (chain)
  
  createdByUserId String?
  createdAt       DateTime @default(now())
  
  garage          Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention    Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("AddendumCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([garageId])
  @@index([garageId, interventionId])
  @@index([createdAt])
}

// ============================================================================
// LEGAL-PACK-01: Legal Documents System
// ============================================================================

/// Scope of legal document visibility
enum LegalDocScope {
  PUBLIC    // Visible on public pages (mentions, cgu, cgv, privacy)
  APP       // Only visible to authenticated users
}

/// Legal document definition (e.g., CGU, CGV, Privacy Policy)
model LegalDoc {
  id          String        @id @default(cuid())
  slug        String        @unique  // e.g., "cgu", "cgv", "mentions-legales"
  title       String                 // e.g., "Conditions Générales d'Utilisation"
  scope       LegalDocScope @default(PUBLIC)
  sortOrder   Int           @default(0)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  
  versions    LegalDocVersion[]
  
  @@index([slug])
  @@index([scope])
}

/// Versioned content for legal documents
model LegalDocVersion {
  id            String    @id @default(cuid())
  legalDocId    String
  versionNumber Int
  
  effectiveAt   DateTime  // When this version becomes effective
  bodyMarkdown  String    @db.Text
  sha256        String    // Hash of bodyMarkdown for integrity
  
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedBy   String?   // userId
  
  createdAt     DateTime  @default(now())
  createdBy     String?   // userId
  
  legalDoc      LegalDoc  @relation(fields: [legalDocId], references: [id], onDelete: Cascade)
  
  @@unique([legalDocId, versionNumber])
  @@index([legalDocId])
  @@index([effectiveAt])
  @@index([isPublished])
}

// ============================================================================
// LEGAL-PACK-01: Company Profile (for Mentions Légales)
// ============================================================================

/// Company profile for legal mentions (singleton per deployment)
model CompanyProfile {
  id                String   @id @default(cuid())
  
  // Legal entity info
  companyName       String   // "SafeMotor"
  legalForm         String   // "EI", "SARL", "SAS", etc.
  address           String
  postalCode        String
  city              String
  country           String   @default("France")
  
  siret             String?
  rcs               String?  // "RCS Paris 123 456 789"
  vatNumber         String?  // "FR12345678901"
  shareCapital      String?  // "1 000 €"
  
  // Contact
  email             String
  phone             String?
  whatsapp          String?
  
  // Publication director
  publicationDirector String
  
  // Hosting provider
  hostingProvider   String   // "Vercel Inc."
  hostingAddress    String   // "440 N Barranca Ave..."
  hostingUrl        String?  // "https://vercel.com"
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

// ============================================================================
// LEGAL-PACK-01: Subprocessors (GDPR DPA)
// ============================================================================

/// GDPR subprocessor for DPA disclosure
model Subprocessor {
  id          String   @id @default(cuid())
  name        String   // "Vercel Inc."
  purpose     String   // "Hébergement de l'application"
  region      String   // "USA (Privacy Shield)", "EU", etc.
  linkUrl     String?  // Privacy policy URL
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  
  @@index([isActive])
}

// ============================================================================
// LEGAL-PACK-01: Intervention Types & Clause Sets
// ============================================================================

/// Type of intervention (for clause selection)
model InterventionTypeRef {
  id          String     @id @default(cuid())
  key         String     @unique  // "E85_REPROG", "E85_BOX", "ECU_REMAP", etc.
  label       String              // "Conversion E85 (Reprogrammation)"
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  
  clauseSets  ClauseSet[]
  
  @@index([key])
  @@index([isActive])
}

/// Set of legal clauses for a specific intervention type
model ClauseSet {
  id                    String              @id @default(cuid())
  interventionTypeId    String?             // null = base/common clauses
  garageId              Int?                // null = official SafeMotor clauses, else custom
  
  name                  String              // "Clauses E85 Reprogrammation"
  isDefault             Boolean             @default(false)
  isActive              Boolean             @default(true)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  
  interventionType      InterventionTypeRef? @relation(fields: [interventionTypeId], references: [id], onDelete: SetNull)
  garage                Garage?             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  versions              ClauseSetVersion[]
  
  @@index([interventionTypeId])
  @@index([garageId])
  @@index([isDefault])
}

/// Versioned content for clause sets
model ClauseSetVersion {
  id            String    @id @default(cuid())
  clauseSetId   String
  versionNumber Int
  
  effectiveAt   DateTime
  bodyMarkdown  String    @db.Text  // Full clause text in markdown
  sha256        String              // Hash for integrity
  
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  
  createdAt     DateTime  @default(now())
  createdBy     String?
  
  clauseSet     ClauseSet @relation(fields: [clauseSetId], references: [id], onDelete: Cascade)
  consents      ConsentRecord[]
  
  @@unique([clauseSetId, versionNumber])
  @@index([clauseSetId])
  @@index([effectiveAt])
  @@index([isPublished])
}

// ============================================================================
// LEGAL-PACK-01: Consent Records (proof of acceptance)
// ============================================================================

/// Record of client consent to legal documents before signature
model ConsentRecord {
  id                    String   @id @default(cuid())
  
  // What was consented to
  signatureRequestId    String?  // Link to signature request
  clauseSetVersionId    String?  // Which clause version was accepted
  
  // Legal docs accepted (slugs + versions as JSON)
  legalDocsAccepted     Json?    // [{"slug":"cgu","version":1},{"slug":"privacy","version":2}]
  
  // Consent proof (hashed for privacy)
  acceptedAt            DateTime @default(now())
  ipHash                String?  // SHA256 of IP address
  userAgentHash         String?  // SHA256 of user agent
  emailHash             String?  // SHA256 of email
  
  signatureMethod       String?  // "EMAIL_LINK", "QR_CODE", "IN_APP"
  
  // Computed integrity hash
  consentHash           String?  // SHA256 of all consent data
  
  clauseSetVersion      ClauseSetVersion? @relation(fields: [clauseSetVersionId], references: [id], onDelete: SetNull)
  
  @@index([signatureRequestId])
  @@index([clauseSetVersionId])
  @@index([acceptedAt])
}

// ============================================================================
// EVIDENCE-CAPTURE-01: Evidence Capture Sessions & Items
// ============================================================================

enum EvidenceCaptureStatus {
  DRAFT       // En cours de saisie
  READY       // Prêt pour signature
  SIGNED      // Signé par client
}

enum EvidenceCaptureStep {
  INTAKE      // Réception véhicule
  TECH        // Diagnostics OBD / technique
  DELIVERY    // Restitution véhicule
}

enum EvidenceItemType {
  PHOTO       // Photo (obligatoire réception)
  VIDEO       // Vidéo (optionnelle)
  FORM        // Formulaire (km, fuel, warnings)
  OBD_REPORT  // Rapport OBD avant/après
  SIGNATURE   // Signature client
  NOTE        // Note textuelle
}

/// Session de capture de preuves pour une intervention
model EvidenceCaptureSession {
  id              String                @id @default(cuid())
  garageId        Int
  interventionId  String
  
  status          EvidenceCaptureStatus @default(DRAFT)
  step            EvidenceCaptureStep   @default(INTAKE)
  
  // Completion tracking
  intakeCompletedAt   DateTime?         // Réception terminée
  techCompletedAt     DateTime?         // Tech terminée
  deliveryCompletedAt DateTime?         // Restitution terminée
  
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdByUserId String?
  
  garage          Garage                @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention    Intervention          @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("EvidenceSessionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           EvidenceItem[]
  
  @@unique([interventionId, step])
  @@index([garageId])
  @@index([interventionId])
  @@index([garageId, status])
}

/// Item de preuve individuel (photo, form, OBD, signature, etc.)
model EvidenceItem {
  id              String           @id @default(cuid())
  garageId        Int
  interventionId  String
  sessionId       String
  
  type            EvidenceItemType
  label           String?          // "Front-left", "Dashboard", "VIN plate", "OBD Before"
  category        String?          // INTAKE_PHOTO, INTAKE_FORM, OBD_BEFORE, OBD_AFTER, DELIVERY_SIGNATURE
  
  // Storage
  storageKey      String?          // Clé S3/local pour fichiers
  fileName        String?          // Nom original du fichier
  mime            String?          // Type MIME
  sizeBytes       Int?             // Taille en bytes
  
  // Structured data (for FORM, OBD_REPORT, etc.)
  jsonData        Json?            // { km, fuel, warnings, dtcCodes, notes, etc. }
  
  // Integrity
  sha256          String           // Hash du fichier ou du JSON stringifié
  
  // Chain linking (for tamper-evidence)
  prevItemHash    String?          // Hash de l'item précédent dans la session
  
  createdAt       DateTime         @default(now())
  createdByUserId String?
  
  garage          Garage           @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention    Intervention     @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  session         EvidenceCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("EvidenceItemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([interventionId, type, createdAt])
  @@index([sessionId])
  @@index([garageId])
  @@index([sha256])
}
