generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GARAGE
  OWNER
  STAFF
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum InterventionStatus {
  DRAFT
  OPEN
  DONE
  CANCELED
}

enum DocumentType {
  INTERVENTION_REPORT
  UPLOAD
  QUOTE_PDF
  INVOICE_PDF
  SIGNED_DOCUMENT
  AUDIT_TRAIL
}

enum GarageStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum LegalSeverity {
  INFO
  WARNING
  CRITICAL
}

model Garage {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String?   @unique
  email      String    @unique
  phone      String?
  address    String?
  siret      String?
  status     GarageStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  // Branding / Profile
  displayName   String?   // Nom commercial affiché
  legalName     String?   // Raison sociale complète
  addressLine1  String?   // Adresse ligne 1
  addressLine2  String?   // Adresse ligne 2 (optionnel)
  postalCode    String?   // Code postal
  city          String?   // Ville
  country       String    @default("France")
  logoKey       String?   // Clé S3/local du logo
  brandColor    String?   // Couleur accent (hex, ex: #4ADE80) - PRO only

  // Organisation settings (quotes/invoices)
  vatNumber       String?                     // Numéro TVA intracommunautaire (ex: FR12345678901)
  defaultVatRate  Float  @default(0.20)
  defaultVatMode  String @default("EXCL")
  vatRatesAllowed Json   @default("[0,0.055,0.10,0.20]")
  quotePrefix       String @default("DEV")
  invoicePrefix     String @default("FAC")
  interventionPrefix String @default("INT")
  numberPadding   Int    @default(4)

  // LEGAL-RETENTION-01: Data retention policy settings
  retentionSignedDocsYears   Int @default(10)   // Signed documents (5-10 years legal)
  retentionAccountingYears   Int @default(10)   // Invoices/quotes (10 years fiscal)
  retentionOperationalDays   Int @default(365)  // Operational data (1 year default)

  // Partner badge (SafeMotor Partner)
  partnerBadgeEnabled       Boolean @default(false)  // Opt-in by garage
  partnerBadgeAdminOverride String  @default("NONE") // NONE | FORCE_ON | FORCE_OFF

  // Public profile (displayed on /garages-partenaires)
  publicProfileEnabled Boolean @default(false)  // Opt-in for public listing
  publicPhone          String?                  // Public phone (optional, distinct from internal)
  publicWebsite        String?                  // Public website URL

  // Referral program
  referralCode          String?  @unique        // Unique code for this garage (e.g., SAFE-XXXX)
  referredByGarageId    Int?                    // Garage that referred this one
  referralStatus        String   @default("NONE") // NONE | PENDING | APPROVED | ACTIVE_SUB
  referralRewardMonths  Int      @default(0)    // Free months earned from referrals
  pendingReferralCouponId       String?         // Stripe coupon ID awaiting confirmation
  pendingReferralMonthsApplied  Int?            // Months being applied (pending confirmation)

  referredByGarage      Garage?  @relation("GarageReferrals", fields: [referredByGarageId], references: [id])
  referredGarages       Garage[] @relation("GarageReferrals")

  plan                Plan               @default(FREE)
  stripeCustomerId    String?            @unique
  stripeSubscriptionId String?           @unique
  subscriptionStatus  SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd    DateTime?
  trialEnd            DateTime?

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  interventions Intervention[]

  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]
  stripeEvents  StripeEvent[]

  numberSequences NumberSequence[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  signatureRequests SignatureRequest[]
  vehicleLookupUsage VehicleLookupUsage[]
  evidenceChain   EvidenceChain[]
  automationJobs  AutomationJob[]
  notificationSettings GarageNotificationSettings?
  appointments    Appointment[]
  repairOrders    RepairOrder[]
  loanVehicles    LoanVehicle[]
  loanContracts   LoanContract[]
  returnReports   ReturnReport[]
  
  // MULTI-USER-ROLES-01: Team members
  members         GarageMember[]
  
  // IMPORT-ONBOARDING-01: Onboarding wizard status and import batches
  onboardingStatus   String   @default("NEW") // NEW | IN_PROGRESS | DONE
  importBatches      ImportBatch[]
}

model User {
  id           String   @id @default(cuid())
  garageId     Int?
  email        String   @unique
  passwordHash String
  role         UserRole @default(GARAGE)
  createdAt    DateTime @default(now())

  garage   Garage?   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  sessions Session[]

  notifications Notification[]
  auditLogs      AuditLog[]
  createdAppointments Appointment[]
  
  // MULTI-USER-ROLES-01: Team memberships
  memberships   GarageMember[]
  
  // IMPORT-ONBOARDING-01: Import batches created by this user
  importBatches ImportBatch[]

  @@index([garageId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// MULTI-USER-ROLES-01: Team membership
// ============================================

enum GarageRole {
  OWNER       // Propriétaire - accès complet
  MANAGER     // Chef d'atelier - gestion équipe, billing
  STAFF       // Mécano - interventions, véhicules
  RECEPTION   // Secrétaire - clients, planning
  READONLY    // Consultation seule
}

enum MemberStatus {
  INVITED     // Invitation envoyée, pas encore acceptée
  ACTIVE      // Membre actif
  DISABLED    // Désactivé par admin
}

model GarageMember {
  id              String       @id @default(cuid())
  garageId        Int
  userId          String?      // Null si invitation en attente
  role            GarageRole   @default(STAFF)
  status          MemberStatus @default(INVITED)
  
  // Invitation fields
  invitedEmail    String?      // Email utilisé pour l'invitation
  inviteTokenHash String?      // SHA256 du token d'invitation
  inviteExpiresAt DateTime?    // Expiration de l'invitation (7 jours)
  
  // Timestamps
  invitedAt       DateTime     @default(now())
  acceptedAt      DateTime?    // Quand l'invitation a été acceptée
  disabledAt      DateTime?    // Quand le membre a été désactivé
  disabledReason  String?      // Motif de désactivation
  
  // Relations
  garage          Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Unique constraints
  @@unique([garageId, userId])           // Un user ne peut être membre qu'une fois par garage
  @@unique([garageId, invitedEmail])     // Un email ne peut être invité qu'une fois par garage
  @@index([garageId])
  @@index([userId])
  @@index([inviteTokenHash])
}

model Client {
  id        Int      @id @default(autoincrement())
  garageId  Int?
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  vatProfile  String @default("PARTICULIER")
  vatRateOverride Float?
  vatNumber   String?
  countryCode String @default("FR")

  email   String?
  phone   String?
  address String?
  notes   String?

  // LEGAL-RETENTION-01: GDPR anonymization tracking
  anonymizedAt   DateTime?  // When client was anonymized (GDPR request)
  anonymizedBy   String?    // userId who performed anonymization

  garage   Garage?  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  quotes   Quote[]
  invoices Invoice[]
  appointments Appointment[]
  loanContracts LoanContract[]

  @@index([garageId])
  @@index([garageId, deletedAt])
  @@index([garageId, lastName, firstName])
}

model Vehicle {
  id        String   @id @default(cuid())
  garageId  Int?
  clientId  Int
  brand     String
  model     String
  plate     String
  vin       String?
  fuel      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  year   Int?
  engine String?

  garage        Garage?        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  quotes   Quote[]
  invoices Invoice[]

  documents Document[]
  appointments Appointment[]

  @@index([garageId])
  @@index([clientId])
  @@index([garageId, deletedAt])
  @@unique([garageId, plate])
  @@unique([garageId, vin])
}

model Intervention {
  id        String   @id @default(cuid())
  garageId  Int?
  vehicleId String
  type      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  status InterventionStatus @default(OPEN)

  title   String?
  amountCents Int?
  // traceability
  createdBy String?
  clientIp  String?
  userAgent String?

  // proof of integrity
  hash    String? @unique
  payload String? // JSON string (snapshot)

  // structured fields for professional interventions / insurance
  performedAt     DateTime?
  odometerKm      Int?
  ecuType         String?
  softwareVersion String?
  checksum        String?

  // === FLOW-INT-01: Parcours logique intervention ===
  // Multi-tags for intervention type
  tags            String[]   @default([])
  
  // Intake (reception)
  intakeChecklist Json?      // { lights: bool, noises: bool, leaks: bool, smoke: bool, ... }
  intakeNotes     String?
  
  // Client agreement
  agreementAt     DateTime?
  agreementMethod String?    // "in_app", "phone", "email", etc.
  
  // Work performed
  workNotes       String?
  partsNotes      String?
  
  // Outtake (restitution)
  outtakeChecklist Json?     // { roadTest: bool, lights: bool, clean: bool, ... }
  closedAt         DateTime?

  // LEGAL-RETENTION-01: Dispute mode (tamper-evident lock)
  disputeStatus     String?    // null = normal, "OPEN" = locked, "CLOSED" = resolved
  disputeOpenedAt   DateTime?  // When dispute was opened
  disputeOpenedBy   String?    // userId who opened dispute
  disputeClosedAt   DateTime?  // When dispute was closed
  disputeClosedBy   String?    // userId who closed dispute
  disputeReason     String?    // Why dispute was opened
  disputeResolution String?    // How dispute was resolved
  disputeSnapshotHash String?  // SHA256 of intervention state at dispute open

  // revisions store immutable snapshots when interventions are created/edited
  revisions InterventionRevision[]

  documents Document[]
  downloadTokens DownloadToken[]
  appointments Appointment[]
  repairOrder  RepairOrder?
  returnReport ReturnReport?

  garage  Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([vehicleId])
  @@index([garageId, deletedAt])
  @@index([garageId, createdAt(sort: Desc)])
  @@index([garageId, status])
}

model Document {
  id             String   @id @default(cuid())
  garageId       Int?
  vehicleId      String?
  interventionId String?

  type     DocumentType
  category String?      @default("DIVERS")  // ENTREE, SORTIE, DIAGNOSTIC, PIECES, DIVERS
  fileUrl  String
  fileName String
  mime     String
  size     Int

  createdAt DateTime @default(now())
  deletedAt DateTime?

  garage       Garage?       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([vehicleId])
  @@index([interventionId])
  @@index([garageId, deletedAt])
  @@index([garageId, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(cuid())
  garageId  Int?
  userId    String?
  type      String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  garageId   Int?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([userId])
  @@index([entityType, entityId])
}

// ============================================
// IMPORT-ONBOARDING-01: Import Batch Tracking
// ============================================

enum ImportKind {
  CLIENTS
  VEHICULES
}

enum ImportStatus {
  DRAFT           // Just created, mapping in progress
  DRY_RUN_DONE    // Dry-run completed, ready for commit
  IMPORTED        // Successfully imported
  ROLLED_BACK     // Rolled back by user
  FAILED          // Import failed
}

model ImportBatch {
  id              String       @id @default(cuid())
  garageId        Int
  kind            ImportKind
  status          ImportStatus @default(DRAFT)
  createdByUserId String?
  
  // Column mapping: { csvColumn: fieldName }
  mappingJson     Json?
  
  // Stats: { totalRows, created, updated, skipped, errorsCount }
  statsJson       Json?
  
  // Error samples (max 50): [{ row, field, message }]
  errorSampleJson Json?
  
  // Track created entity IDs for rollback
  createdIdsJson  Json?        // Array of created client/vehicle IDs
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  
  garage          Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  @@index([garageId, createdAt])
  @@index([garageId, status])
}

model StripeEvent {
  id            String   @id
  garageId      Int?
  type          String
  apiVersion    String?
  created       Int
  livemode      Boolean
  processedAt   DateTime?
  lastError     String?
  receivedAt    DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([type])
  @@index([processedAt])
}

model NumberSequence {
  id             String @id @default(cuid())
  organisationId Int
  type           String
  year           Int
  nextNumber     Int    @default(1)

  organisation Garage @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, type, year])
  @@index([organisationId, type, year])
}

model Quote {
  id             String   @id @default(cuid())
  organisationId Int
  clientId       Int
  vehicleId      String?

  status      String  @default("DRAFT")
  quoteNumber String?
  quoteYear   Int?
  quoteSeq    Int?

  currency     String @default("EUR")
  vatMode      String
  subtotalExcl Float  @default(0)
  totalVat     Float  @default(0)
  totalIncl    Float  @default(0)

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  invoicedAt DateTime?
  invoiceId  String?

  invoice Invoice? @relation("QuoteToInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  organisation Garage   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines        QuoteLine[]
  downloadTokens QuoteDownloadToken[]

  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, clientId])
  @@index([organisationId, vehicleId])
  @@index([organisationId, status])
  @@index([organisationId, quoteNumber])
}

model QuoteLine {
  id            String   @id @default(cuid())
  quoteId       String
  description   String
  qty           Float    @default(1)
  unitPriceExcl Float
  vatRate       Float    @default(0.20)
  lineTotalExcl Float    @default(0)
  lineVatAmount Float    @default(0)
  lineTotalIncl Float    @default(0)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([quoteId, deletedAt])
}

model Invoice {
  id             String   @id @default(cuid())
  organisationId Int
  clientId       Int
  vehicleId      String?
  quoteId        String? @unique

  status        String  @default("DRAFT")  // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELED
  invoiceNumber String?
  invoiceYear   Int?
  invoiceSeq    Int?

  currency     String @default("EUR")
  vatMode      String
  subtotalExcl Float  @default(0)
  totalVat     Float  @default(0)
  totalIncl    Float  @default(0)
  amountPaid   Float  @default(0)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  // PAYMENTS-01: Payment link for online payments
  paymentLinkUrl       String?   // Current active Stripe Checkout URL
  paymentLinkExpiresAt DateTime? // Link expiration (24h by default)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  organisation Garage   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  quote        Quote?   @relation("QuoteToInvoice", fields: [quoteId], references: [id], onDelete: SetNull)

  lines    InvoiceLine[]
  payments Payment[]
  downloadTokens InvoiceDownloadToken[]

  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, clientId])
  @@index([organisationId, vehicleId])
  @@index([organisationId, status])
  @@index([organisationId, invoiceNumber])
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  description   String
  qty           Float    @default(1)
  unitPriceExcl Float
  vatRate       Float    @default(0.20)
  lineTotalExcl Float    @default(0)
  lineVatAmount Float    @default(0)
  lineTotalIncl Float    @default(0)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, deletedAt])
}

model Payment {
  id             String   @id @default(cuid())
  organisationId Int
  invoiceId      String
  amount         Float
  method         String   // CASH, CARD, TRANSFER, STRIPE, OTHER
  status         String   @default("SUCCEEDED") // PENDING, SUCCEEDED, FAILED, CANCELED
  paymentType    String?  // FULL, DEPOSIT (for Stripe payments)
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  // PAYMENTS-01: Stripe fields for online payments
  stripePaymentIntentId   String?  @unique
  stripeCheckoutSessionId String?  @unique
  currency                String?  @default("eur")

  organisation Garage  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([invoiceId])
  @@index([organisationId, invoiceId])
  @@index([stripePaymentIntentId])
}

// ============================================
// DOWNLOAD TOKENS FOR QUOTES/INVOICES: Secure email links
// ============================================

model QuoteDownloadToken {
  id        String   @id @default(cuid())
  quoteId   String
  tokenHash String   @unique // SHA256 of the actual token
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime? // Track first download

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([quoteId])
}

model InvoiceDownloadToken {
  id        String   @id @default(cuid())
  invoiceId String
  tokenHash String   @unique // SHA256 of the actual token
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime? // Track first download

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([invoiceId])
}

model InterventionRevision {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?
  clientIp  String?
  userAgent String?

  payload String
  hash    String

  @@index([interventionId])
}

model LegalReference {
  id         String        @id @default(cuid())
  title      String
  summary    String?
  sourceUrl  String?
  code       String?
  articleRef String?
  tags       String?
  severity   LegalSeverity @default(INFO)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  assignments LegalReferenceAssignment[]
}

model LegalReferenceAssignment {
  id               String         @id @default(cuid())
  referenceId      String
  interventionType String

  reference LegalReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([referenceId])
  @@index([interventionType])
}

// ============================================
// SIGN-CORE-01: Signature System
// ============================================

enum SignatureDocumentType {
  INTERVENTION_ORDER
  INTERVENTION_DELIVERY
  INTERVENTION_DOSSIER
  QUOTE
  REPAIR_ORDER          // WORKSHOP-OPS-01: Ordre de Réparation
  RETURN_REPORT         // WORKSHOP-OPS-01: PV de restitution
  LOAN_CONTRACT_OUT     // WORKSHOP-OPS-01: Contrat prêt (départ)
  LOAN_CONTRACT_IN      // WORKSHOP-OPS-01: Contrat prêt (retour)
}

enum SignatureStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  VOID
  SUPERSEDED  // HARDEN-01: When replaced by a new revision
}

model SignatureRequest {
  id               String                @id @default(cuid())
  token            String                @unique
  expiresAt        DateTime
  documentType     SignatureDocumentType
  documentId       String
  garageId         Int
  clientId         Int?
  status           SignatureStatus       @default(DRAFT)
  pdfHash          String?               // Hash du PDF avant signature
  pdfRoute         String?
  signerNameDeclared String?
  signerEmail      String?
  signedAt         DateTime?
  lastViewedAt     DateTime?
  sentAt           DateTime?             // Date d'envoi
  voidedAt         DateTime?             // Date d'annulation
  createdAt        DateTime              @default(now())
  createdByUserId  String?
  
  // HARDEN-01: Revision tracking
  revision         Int                   @default(1)
  supersededById   String?               // ID of the new revision that replaced this one
  
  // Signed PDF storage
  signedPdfHash    String?               // SHA256 du PDF signé final
  signedPdfKey     String?               // Clé de stockage (local ou S3)
  signedPdfUrl     String?               // URL publique ou route
  
  // Legal snapshot at signature time
  legalSnapshotJson String?              // JSON des clauses exactes signées
  legalSnapshotHash String?              // SHA256 du snapshot légal

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  events SignatureEvent[]

  @@index([token])
  @@index([garageId])
  @@index([documentType, documentId])
  @@index([status])
  @@index([garageId, status])
}

model SignatureEvent {
  id                 String   @id @default(cuid())
  signatureRequestId String
  type               String   // CREATED, SENT, VIEWED, SIGNED, DECLINED
  at                 DateTime @default(now())
  ip                 String?
  userAgent          String?
  metaJson           Json?

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId])
}

// ============================================
// DOWNLOAD TOKENS: Secure download links for signed documents
// ============================================

model DownloadToken {
  id             String   @id @default(cuid())
  interventionId String
  purpose        String   // SIGNED_PDF, DOSSIER_ZIP
  tokenHash      String   @unique // SHA256 of the actual token
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  usedAt         DateTime? // Optional: mark first download

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@unique([interventionId, purpose])
  @@index([tokenHash])
  @@index([interventionId])
}

// ============================================
// VEHICLE-LOOKUP: Plate lookup cache, usage quotas, logs
// ============================================

/// Monthly quota tracking per garage (for billing/rate limiting)
model VehicleLookupUsage {
  id        String @id @default(cuid())
  garageId  Int
  monthKey  String // "2026-01" format
  count     Int    @default(0)
  updatedAt DateTime @updatedAt

  garage    Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, monthKey])
  @@index([garageId])
}

model VehicleLookupCache {
  id              String   @id @default(cuid())
  garageId        Int
  plateNormalized String
  provider        String   @default("apiplaqueimmatriculation")
  dataJson        String   // JSON string of VehiclePrefill
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([garageId, plateNormalized, provider])
  @@index([garageId])
  @@index([expiresAt])
}

model VehicleLookupLog {
  id              String   @id @default(cuid())
  garageId        Int
  plateNormalized String
  provider        String
  success         Boolean
  source          String?  // "cache" | "api"
  errorCode       String?
  latencyMs       Int?     // API call duration in milliseconds
  createdAt       DateTime @default(now())

  @@index([garageId])
  @@index([createdAt])
}

// ============================================================
// Referral Events (tracking)
// ============================================================
model ReferralEvent {
  id               String   @id @default(cuid())
  referrerGarageId Int
  refereeGarageId  Int
  eventType        String   // REF_APPLIED | REF_APPROVED | REWARD_GRANTED
  createdAt        DateTime @default(now())
  metaJson         String?  // Optional JSON metadata

  @@index([referrerGarageId])
  @@index([refereeGarageId])
  @@index([createdAt])
}

// ============================================================
// AI Usage Tracking (quota enforcement)
// ============================================================
model AiUsageLog {
  id             String   @id @default(cuid())
  garageId       Int
  interventionId String?  // Optional: may be used outside interventions in future
  mode           String   // CHECKLIST | SUMMARY | RISKS
  provider       String   // openai | anthropic | mock
  tokensUsed     Int      @default(0)
  success        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([garageId, createdAt])
  @@index([createdAt])
}

// ============================================================
// Rate Limiting Buckets (anti-abuse)
// ============================================================
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   // e.g., "ip:1.2.3.4:sign_get" or "garage:123:send_email"
  windowStart DateTime // Start of the rate limit window (rounded to window size)
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
  @@index([windowStart])
}

// System health events for admin monitoring (no PII)
model SystemEvent {
  id        String   @id @default(cuid())
  type      String   // "health_check" | "alert" | "recovery" | "startup"
  service   String   // "db" | "stripe" | "email" | "ai" | "storage" | "system"
  status    String   // "ok" | "degraded" | "down"
  message   String?  // Generic message, no PII
  metadata  Json?    // Metrics only (latency, counts)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([service])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// LEGAL-RETENTION-01: EvidenceChain - Tamper-evident hash chain
// ============================================================
// Each entry contains hash of (previous_hash + payload) creating a chain.
// Used for: dispute snapshots, critical legal events, GDPR actions.
// Any tampering breaks the chain - detectible by verification.

model EvidenceChain {
  id           String   @id @default(cuid())
  garageId     Int
  entityType   String   // "intervention" | "client" | "signature" | "invoice"
  entityId     String   // ID of the entity (interventionId, clientId, etc.)
  eventType    String   // "dispute_open" | "dispute_close" | "anonymize" | "export" | "snapshot"
  
  payload      String   // JSON snapshot of entity state at this moment
  payloadHash  String   // SHA256(payload)
  previousHash String?  // Hash of previous entry in chain (null for first entry per entity)
  chainHash    String   // SHA256(previousHash + payloadHash) - the immutable chain link
  
  userId       String?  // Who performed the action
  ip           String?  // IP address (for legal traceability)
  userAgent    String?  // Browser/client info
  reason       String?  // Why this event occurred (dispute reason, etc.)
  
  createdAt    DateTime @default(now())

  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@index([chainHash])
}

// ============================================================
// AUTOMATIONS-01: Job scheduler for reminders and alerts
// ============================================================

enum AutomationJobKind {
  SIGN_REMINDER
  QUOTE_REMINDER
  INVOICE_REMINDER
  QUOTA_ALERT
  ADMIN_DIGEST
  APPOINTMENT_REMINDER
}

enum AutomationJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model AutomationJob {
  id         String              @id @default(cuid())
  kind       AutomationJobKind
  garageId   Int
  targetType String              // "signature_request" | "quote" | "invoice" | "garage"
  targetId   String              // ID of the target entity
  
  runAt      DateTime            // When to execute
  status     AutomationJobStatus @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?             // Redacted error message
  
  // Deduplication key for quota alerts (e.g., "garage:1:quota:vehicleLookup:80:2026-01")
  dedupKey   String?             @unique
  
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  garage     Garage              @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([garageId])
  @@index([kind])
  @@index([targetType, targetId])
}

// Garage notification preferences (opt-in toggles)
model GarageNotificationSettings {
  id                    String   @id @default(cuid())
  garageId              Int      @unique
  
  // Reminder toggles
  signatureReminders    Boolean  @default(true)
  quoteReminders        Boolean  @default(false)
  invoiceReminders      Boolean  @default(false)
  quotaAlerts           Boolean  @default(true)
  appointmentsReminders Boolean  @default(true)
  
  // Daily email limit to prevent spam (per garage)
  dailyEmailLimit       Int      @default(50)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  garage                Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

// ============================================================
// APPOINTMENTS-01: Appointment scheduling
// ============================================================

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
  NO_SHOW
}

enum ReminderPolicy {
  NONE
  STANDARD  // J-1 + H-2
}

model Appointment {
  id              String            @id @default(cuid())
  garageId        Int
  clientId        Int
  vehicleId       String?
  interventionId  String?
  
  title           String            // "Diag", "E85", "Reprog", etc.
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  
  // Reminder configuration
  reminderPolicy      ReminderPolicy @default(NONE)
  reminderSentJ1At    DateTime?      // J-1 reminder sent timestamp
  reminderSentH2At    DateTime?      // H-2 reminder sent timestamp
  
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  garage          Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  intervention    Intervention?     @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([garageId, startAt])
  @@index([garageId, clientId])
  @@index([interventionId])
}

// ============================================
// WORKSHOP-OPS-01: Repair Order (Ordre de Réparation)
// ============================================

enum RepairOrderStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

model RepairOrder {
  id             String            @id @default(cuid())
  garageId       Int
  interventionId String            @unique
  status         RepairOrderStatus @default(DRAFT)
  
  // Snapshot of intervention data at issue time
  snapshotJson   String?           // JSON: vehicle, client, items, prices, clauses
  
  // PDF storage
  pdfKey         String?           // Storage key (local or S3)
  pdfHashSha256  String?           // SHA256 of the PDF
  
  // Signature
  signatureRequestId String?       // FK to SignatureRequest
  
  // Timestamps
  issuedAt       DateTime?         // When OR was frozen and sent
  signedAt       DateTime?         // When client signed
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  garage         Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention   Intervention      @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([garageId, interventionId])
}

// ============================================
// WORKSHOP-OPS-01: Loan Vehicle (Véhicule de prêt)
// ============================================

model LoanVehicle {
  id           String   @id @default(cuid())
  garageId     Int
  plate        String   // License plate (stored for identification)
  make         String?  // Brand
  model        String?
  year         Int?
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  contracts    LoanContract[]

  @@index([garageId])
  @@index([garageId, active])
}

// ============================================
// WORKSHOP-OPS-01: Loan Contract (Contrat de prêt)
// ============================================

enum LoanContractStatus {
  OUT        // Vehicle is out with client
  RETURNED   // Vehicle returned normally
  DISPUTE    // Issue with return
}

enum FuelLevel {
  EMPTY      // 0%
  QUARTER    // 25%
  HALF       // 50%
  THREE_QUARTERS // 75%
  FULL       // 100%
}

model LoanContract {
  id              String             @id @default(cuid())
  garageId        Int
  loanVehicleId   String
  clientId        Int
  interventionId  String?            // Optional link to intervention
  
  // Departure (OUT)
  startAt         DateTime
  endAtPlanned    DateTime?          // Planned return date
  kmOut           Int                // Odometer at departure
  fuelOut         FuelLevel          @default(HALF)
  conditionOut    String?            // Text description of vehicle state
  photosOutKeys   String[]           @default([]) // Storage keys for photos
  
  // Return (IN)
  returnAt        DateTime?          // Actual return date
  kmIn            Int?               // Odometer at return
  fuelIn          FuelLevel?
  conditionIn     String?            // Text description at return
  photosInKeys    String[]           @default([]) // Storage keys for photos
  
  status          LoanContractStatus @default(OUT)
  
  // PDF storage
  pdfKey          String?            // Contract PDF storage key
  pdfHashSha256   String?            // SHA256 of the PDF
  
  // Signatures (two: one at departure, one at return)
  signatureRequestOutId String?      // Signature for departure
  signatureRequestInId  String?      // Signature for return
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  garage          Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  loanVehicle     LoanVehicle        @relation(fields: [loanVehicleId], references: [id], onDelete: Cascade)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([garageId, clientId])
  @@index([garageId, loanVehicleId])
  @@index([garageId, startAt])
}

// ============================================
// WORKSHOP-OPS-01: Return Report (PV de restitution)
// ============================================

enum ReturnReportStatus {
  DRAFT
  SENT
  SIGNED
}

model ReturnReport {
  id             String             @id @default(cuid())
  garageId       Int
  interventionId String             @unique
  
  // Checklist data
  checklistJson  String?            // JSON: { roadTest: bool, lights: bool, clean: bool, damages: [], ... }
  notes          String?
  
  // Photos
  photosKeys     String[]           @default([]) // Storage keys for photos
  
  status         ReturnReportStatus @default(DRAFT)
  
  // PDF storage
  pdfKey         String?            // Storage key (local or S3)
  pdfHashSha256  String?            // SHA256 of the PDF
  
  // Signature
  signatureRequestId String?        // FK to SignatureRequest
  
  // Timestamps
  issuedAt       DateTime?          // When PV was frozen and sent
  signedAt       DateTime?          // When client signed
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  garage         Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  intervention   Intervention       @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([garageId, interventionId])
}
