generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GARAGE
}

enum GarageStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Garage {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  phone      String?
  address    String?
  siret      String?
  status     GarageStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  interventions Intervention[]
}

model User {
  id           String   @id @default(cuid())
  garageId     Int?
  email        String   @unique
  passwordHash String
  role         UserRole @default(GARAGE)
  createdAt    DateTime @default(now())

  garage   Garage?   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([garageId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id        Int      @id @default(autoincrement())
  garageId  Int?
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  garage   Garage?  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@index([garageId])
}

model Vehicle {
  id        String   @id @default(cuid())
  garageId  Int?
  clientId  Int
  brand     String
  model     String
  plate     String   @unique
  vin       String?  @unique
  fuel      String?
  createdAt DateTime @default(now())

  garage        Garage?        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@index([garageId])
}

model Intervention {
  id        String   @id @default(cuid())
  garageId  Int?
  vehicleId String
  type      String
  notes     String?
  createdAt DateTime @default(now())
  // traceability
  createdBy String?
  clientIp  String?
  userAgent String?

  // proof of integrity
  hash    String? @unique
  payload String? // JSON string (snapshot)

  // structured fields for professional interventions / insurance
  performedAt     DateTime?
  odometerKm      Int?
  ecuType         String?
  softwareVersion String?
  checksum        String?

  // attachments will be implemented later (file paths / storage references)
  // attachments String[]

  // revisions store immutable snapshots when interventions are created/edited
  revisions InterventionRevision[]

  garage  Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([garageId])
}

model InterventionRevision {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?
  clientIp  String?
  userAgent String?

  payload String
  hash    String

  @@index([interventionId])
}
