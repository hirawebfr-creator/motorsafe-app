  qty           Float    @default(1)
  unitPriceExcl Float
  vatRate       Float    @default(0.20)
  lineTotalExcl Float    @default(0)
  lineVatAmount Float    @default(0)
  lineTotalIncl Float    @default(0)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

