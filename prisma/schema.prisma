generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GARAGE
  OWNER
  STAFF
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum InterventionStatus {
  DRAFT
  OPEN
  DONE
  CANCELED
}

enum DocumentType {
  INTERVENTION_REPORT
  UPLOAD
  QUOTE_PDF
  INVOICE_PDF
  SIGNED_DOCUMENT
  AUDIT_TRAIL
}

enum GarageStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum LegalSeverity {
  INFO
  WARNING
  CRITICAL
}

model Garage {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String?   @unique
  email      String    @unique
  phone      String?
  address    String?
  siret      String?
  status     GarageStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  // Organisation settings (quotes/invoices)
  defaultVatRate  Float  @default(0.20)
  defaultVatMode  String @default("EXCL")
  vatRatesAllowed Json   @default("[0,0.055,0.10,0.20]")
  quotePrefix     String @default("DEV")
  invoicePrefix   String @default("FAC")
  numberPadding   Int    @default(4)

  plan                Plan               @default(FREE)
  stripeCustomerId    String?            @unique
  stripeSubscriptionId String?           @unique
  subscriptionStatus  SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd    DateTime?
  trialEnd            DateTime?

  users         User[]
  clients       Client[]
  vehicles      Vehicle[]
  interventions Intervention[]

  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]
  stripeEvents  StripeEvent[]

  numberSequences NumberSequence[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  signatureRequests SignatureRequest[]
}

model User {
  id           String   @id @default(cuid())
  garageId     Int?
  email        String   @unique
  passwordHash String
  role         UserRole @default(GARAGE)
  createdAt    DateTime @default(now())

  garage   Garage?   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  sessions Session[]

  notifications Notification[]
  auditLogs      AuditLog[]

  @@index([garageId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id        Int      @id @default(autoincrement())
  garageId  Int?
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  vatProfile  String @default("PARTICULIER")
  vatRateOverride Float?
  vatNumber   String?
  countryCode String @default("FR")

  email   String?
  phone   String?
  address String?
  notes   String?

  garage   Garage?  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  quotes   Quote[]
  invoices Invoice[]

  @@index([garageId])
  @@index([garageId, deletedAt])
}

model Vehicle {
  id        String   @id @default(cuid())
  garageId  Int?
  clientId  Int
  brand     String
  model     String
  plate     String
  vin       String?
  fuel      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  year   Int?
  engine String?

  garage        Garage?        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  quotes   Quote[]
  invoices Invoice[]

  documents Document[]

  @@index([garageId])
  @@index([clientId])
  @@index([garageId, deletedAt])
  @@unique([garageId, plate])
  @@unique([garageId, vin])
}

model Intervention {
  id        String   @id @default(cuid())
  garageId  Int?
  vehicleId String
  type      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  status InterventionStatus @default(OPEN)

  title   String?
  amountCents Int?
  // traceability
  createdBy String?
  clientIp  String?
  userAgent String?

  // proof of integrity
  hash    String? @unique
  payload String? // JSON string (snapshot)

  // structured fields for professional interventions / insurance
  performedAt     DateTime?
  odometerKm      Int?
  ecuType         String?
  softwareVersion String?
  checksum        String?

  // === FLOW-INT-01: Parcours logique intervention ===
  // Multi-tags for intervention type
  tags            String[]   @default([])
  
  // Intake (reception)
  intakeChecklist Json?      // { lights: bool, noises: bool, leaks: bool, smoke: bool, ... }
  intakeNotes     String?
  
  // Client agreement
  agreementAt     DateTime?
  agreementMethod String?    // "in_app", "phone", "email", etc.
  
  // Work performed
  workNotes       String?
  partsNotes      String?
  
  // Outtake (restitution)
  outtakeChecklist Json?     // { roadTest: bool, lights: bool, clean: bool, ... }
  closedAt         DateTime?

  // revisions store immutable snapshots when interventions are created/edited
  revisions InterventionRevision[]

  documents Document[]

  garage  Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([vehicleId])
  @@index([garageId, deletedAt])
}

model Document {
  id             String   @id @default(cuid())
  garageId       Int?
  vehicleId      String?
  interventionId String?

  type     DocumentType
  category String?      @default("DIVERS")  // ENTREE, SORTIE, DIAGNOSTIC, PIECES, DIVERS
  fileUrl  String
  fileName String
  mime     String
  size     Int

  createdAt DateTime @default(now())
  deletedAt DateTime?

  garage       Garage?       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([vehicleId])
  @@index([interventionId])
  @@index([garageId, deletedAt])
}

model Notification {
  id        String   @id @default(cuid())
  garageId  Int?
  userId    String?
  type      String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  garageId   Int?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([userId])
  @@index([entityType, entityId])
}

model StripeEvent {
  id            String   @id
  garageId      Int?
  type          String
  apiVersion    String?
  created       Int
  livemode      Boolean
  processedAt   DateTime?
  lastError     String?
  receivedAt    DateTime @default(now())

  garage Garage? @relation(fields: [garageId], references: [id], onDelete: SetNull)

  @@index([garageId])
  @@index([type])
  @@index([processedAt])
}

model NumberSequence {
  id             String @id @default(cuid())
  organisationId Int
  type           String
  year           Int
  nextNumber     Int    @default(1)

  organisation Garage @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, type, year])
  @@index([organisationId, type, year])
}

model Quote {
  id             String   @id @default(cuid())
  organisationId Int
  clientId       Int
  vehicleId      String?

  status      String  @default("DRAFT")
  quoteNumber String?
  quoteYear   Int?
  quoteSeq    Int?

  currency     String @default("EUR")
  vatMode      String
  subtotalExcl Float  @default(0)
  totalVat     Float  @default(0)
  totalIncl    Float  @default(0)

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  invoicedAt DateTime?
  invoiceId  String?

  invoice Invoice? @relation("QuoteToInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  organisation Garage   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines        QuoteLine[]

  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, clientId])
  @@index([organisationId, vehicleId])
  @@index([organisationId, status])
  @@index([organisationId, quoteNumber])
}

model QuoteLine {
  id            String   @id @default(cuid())
  quoteId       String
  description   String
  qty           Float    @default(1)
  unitPriceExcl Float
  vatRate       Float    @default(0.20)
  lineTotalExcl Float    @default(0)
  lineVatAmount Float    @default(0)
  lineTotalIncl Float    @default(0)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([quoteId, deletedAt])
}

model Invoice {
  id             String   @id @default(cuid())
  organisationId Int
  clientId       Int
  vehicleId      String?
  quoteId        String? @unique

  status        String  @default("DRAFT")
  invoiceNumber String?
  invoiceYear   Int?
  invoiceSeq    Int?

  currency     String @default("EUR")
  vatMode      String
  subtotalExcl Float  @default(0)
  totalVat     Float  @default(0)
  totalIncl    Float  @default(0)
  amountPaid   Float  @default(0)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  organisation Garage   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  quote        Quote?   @relation("QuoteToInvoice", fields: [quoteId], references: [id], onDelete: SetNull)

  lines    InvoiceLine[]
  payments Payment[]

  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, clientId])
  @@index([organisationId, vehicleId])
  @@index([organisationId, status])
  @@index([organisationId, invoiceNumber])
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  description   String
  qty           Float    @default(1)
  unitPriceExcl Float
  vatRate       Float    @default(0.20)
  lineTotalExcl Float    @default(0)
  lineVatAmount Float    @default(0)
  lineTotalIncl Float    @default(0)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, deletedAt])
}

model Payment {
  id             String   @id @default(cuid())
  organisationId Int
  invoiceId      String
  amount         Float
  method         String
  status         String   @default("SUCCEEDED")
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  organisation Garage  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([invoiceId])
  @@index([organisationId, invoiceId])
}

model InterventionRevision {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?
  clientIp  String?
  userAgent String?

  payload String
  hash    String

  @@index([interventionId])
}

model LegalReference {
  id         String        @id @default(cuid())
  title      String
  summary    String?
  sourceUrl  String?
  code       String?
  articleRef String?
  tags       String?
  severity   LegalSeverity @default(INFO)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  assignments LegalReferenceAssignment[]
}

model LegalReferenceAssignment {
  id               String         @id @default(cuid())
  referenceId      String
  interventionType String

  reference LegalReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([referenceId])
  @@index([interventionType])
}

// ============================================
// SIGN-CORE-01: Signature System
// ============================================

enum SignatureDocumentType {
  INTERVENTION_ORDER
  INTERVENTION_DELIVERY
  INTERVENTION_DOSSIER
  QUOTE
}

enum SignatureStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  VOID
  SUPERSEDED  // HARDEN-01: When replaced by a new revision
}

model SignatureRequest {
  id               String                @id @default(cuid())
  token            String                @unique
  expiresAt        DateTime
  documentType     SignatureDocumentType
  documentId       String
  garageId         Int
  clientId         Int?
  status           SignatureStatus       @default(DRAFT)
  pdfHash          String?               // Hash du PDF avant signature
  pdfRoute         String?
  signerNameDeclared String?
  signerEmail      String?
  signedAt         DateTime?
  lastViewedAt     DateTime?
  sentAt           DateTime?             // Date d'envoi
  voidedAt         DateTime?             // Date d'annulation
  createdAt        DateTime              @default(now())
  createdByUserId  String?
  
  // HARDEN-01: Revision tracking
  revision         Int                   @default(1)
  supersededById   String?               // ID of the new revision that replaced this one
  
  // Signed PDF storage
  signedPdfHash    String?               // SHA256 du PDF signé final
  signedPdfKey     String?               // Clé de stockage (local ou S3)
  signedPdfUrl     String?               // URL publique ou route
  
  // Legal snapshot at signature time
  legalSnapshotJson String?              // JSON des clauses exactes signées
  legalSnapshotHash String?              // SHA256 du snapshot légal

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  events SignatureEvent[]

  @@index([token])
  @@index([garageId])
  @@index([documentType, documentId])
}

model SignatureEvent {
  id                 String   @id @default(cuid())
  signatureRequestId String
  type               String   // CREATED, SENT, VIEWED, SIGNED, DECLINED
  at                 DateTime @default(now())
  ip                 String?
  userAgent          String?
  metaJson           Json?

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId])
}

// ============================================
// VEHICLE-LOOKUP: Plate lookup cache
// ============================================

model VehicleLookupCache {
  id              String   @id @default(cuid())
  garageId        Int
  plateNormalized String
  provider        String   @default("apiplaqueimmatriculation")
  dataJson        String   // JSON string of VehiclePrefill
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([garageId, plateNormalized, provider])
  @@index([garageId])
  @@index([expiresAt])
}

model VehicleLookupLog {
  id              String   @id @default(cuid())
  garageId        Int
  plateNormalized String
  provider        String
  success         Boolean
  source          String?  // "cache" | "api"
  errorCode       String?
  createdAt       DateTime @default(now())

  @@index([garageId])
  @@index([createdAt])
}
