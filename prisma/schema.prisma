  @@index([invoiceId, deletedAt])
}

model Payment {
  id             String   @id @default(cuid())
  organisationId Int
  invoiceId      String
  amount         Float
  method         String   // CASH, CARD, TRANSFER, STRIPE, OTHER
  status         String   @default("SUCCEEDED") // PENDING, SUCCEEDED, FAILED, CANCELED
